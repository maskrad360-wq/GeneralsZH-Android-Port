<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#090C08"
                android:centerColor="#0C100B"
                android:endColor="#070907" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#D2B35F" />
        </shape>
    </item>
</layer-list>
